# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: model selection ────────────────────────────────────────────────
# claude-haiku-4-5-20251001  (default — cheapest, fastest)
# claude-3-5-sonnet-20241022 (higher quality, ~20× cost)
MODEL=claude-haiku-4-5-20251001

# ── Optional: memory constraints ─────────────────────────────────────────────
MAX_WORKING_TOKENS=2000    # tokens per LLM call context window
MAX_EPISODIC_SIZE=5        # episodes before vector store flush

# ── Optional: budget constraints ─────────────────────────────────────────────
MAX_SESSION_TOKENS=50000   # total tokens per session
MAX_SESSION_COST=0.10      # USD hard ceiling per session
MAX_API_CALLS=20           # max LLM calls per session
